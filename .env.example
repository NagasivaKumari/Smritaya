# --- Lyzr (agents) ---
LYZR_API_KEY=
LYZR_AGENT_ID=
# optional: separate specialized agents (all fall back to LYZR_AGENT_ID)
LYZR_EXTRACTOR_AGENT_ID=
LYZR_ADVISOR_AGENT_ID=
LYZR_DRAFTER_AGENT_ID=
LYZR_USER_ID=founder@smritaya.app

# --- Qdrant (memory) ---
# QDRANT_MODE=local  -> embedded store at QDRANT_PATH (zero setup)
# QDRANT_MODE=remote -> server or cloud
QDRANT_MODE=local
QDRANT_PATH=./qdrant_data
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Omi outbound notifications (optional) ---
# from the Omi developer portal; lets the witness push a reminder to your phone
OMI_APP_ID=
OMI_APP_SECRET=

# --- retrieval / Omi webhook guards (optional) ---
# drop recalled deeds scoring below this (rag anti-hallucination);
# bge-small: unrelated ~0.45, real matches ~0.6+, so 0.55 separates
SMRITAYA_SCORE_THRESHOLD=0.55
# Optional shared secret. Leave BLANK for the demo. If set, Omi must call the webhook
# with ?token=SECRET — but Omi also APPENDS its own ?uid=..., so only set this if your
# tunnel is public and you can control the query string. Blank = open (recommended).
SMRITAYA_OMI_SECRET=
# ignore speech fragments shorter than this many characters
SMRITAYA_MIN_CHARS=8
# join realtime transcript pieces after this many seconds of silence
SMRITAYA_SILENCE_SECONDS=3

# --- misc ---
SMRITAYA_DEMO_UID=founder
